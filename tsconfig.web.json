{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/src/*"],
      "@framework/*": ["src/renderer/src/types/cubism-shim"],
      "@cubismsdksamples/*": ["src/renderer/src/types/cubism-shim"],
      "@motionsyncframework/*": ["src/renderer/src/types/cubism-shim"],
      "@motionsync/*": ["src/renderer/src/types/cubism-shim"]
    }
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/renderer/**/*.d.ts"
  ],
  "exclude": [
    "src/renderer/WebSDK/**/*"
  ]
}
